{
  "name": "@dojo/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:deployed": "playwright test --config=playwright.deployed.config.ts",
    "typecheck": "tsc --noEmit",
    "conformance": "pnpm --filter=@dojo/scroll-conformance... build && node fixtures/reference-scroll/conformance.mjs"
  },
  "devDependencies": {
    "@dojo/scroll-conformance": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
