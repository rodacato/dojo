{
  "name": "@dojo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/infrastructure/persistence/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=../../.env src/infrastructure/persistence/seed.ts",
    "calibrate:sensei": "tsx --env-file=../../.env src/scripts/calibrate-sensei.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@dojo/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.74.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.5.4",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "resend": "^6.28.0",
    "satori": "^0.33.4",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
