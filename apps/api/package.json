{
  "name": "@dojo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/infrastructure/persistence/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=../../.env src/infrastructure/persistence/seed.ts",
    "db:seed:demo": "tsx --env-file=../../.env src/infrastructure/persistence/seed-demo.ts",
    "calibrate:sensei": "tsx --env-file=../../.env src/scripts/calibrate-sensei.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dojo/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.8.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "resend": "^6.33.0",
    "satori": "^0.63.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-istanbul": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
