# Copy to .devcontainer/local.env (gitignored) to run read-only Kamal commands
# such as `kamal config -c config/deploy.api.yml` from inside the devcontainer.
#
# Non-secret values only. Never add DATABASE_URL, SESSION_SECRET, POSTGRES_PASSWORD,
# LLM_API_KEY, TURNSTILE_SECRET_KEY or any other credential: a compromised container
# would hand over production. Deploys run in CI.
#
# GITHUB_USERNAME is derived from the git remote, so it is not listed here.

# VPS the deploy targets — the production GitHub Environment variable HOST_IP.
HOST_IP=

# Public hostnames without scheme, mirrored from the production GitHub Environment
# variables. Kamal refuses to render its config when either is empty.
APP_HOST=
API_HOST=
