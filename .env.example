# Copy to `.env` and fill in the values marked SECRET; the rest are working local defaults.
# To sign in you need:
#   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET   an OAuth app (github.com/settings/applications/new)
#   CREATOR_GITHUB_ID                        your GitHub numeric id; you become the instance's operator
# The sensei runs in `mock` mode by default, so no LLM key is needed to boot.
# Guide: GETTING_STARTED.md. Running it for real: docs/ops/runbook.md.

# Database
DATABASE_URL=postgresql://dojo:dojo@db:5432/dojo_dev   # host `db` only resolves inside Docker; use localhost on bare metal
POSTGRES_USER=dojo
POSTGRES_DB=dojo_dev                              # must match the database in DATABASE_URL
POSTGRES_PASSWORD=dojo                            # SECRET — change it, and the password in DATABASE_URL, on any instance others can reach

# App
NODE_ENV=development                              # `production` makes the API refuse the dev SESSION_SECRET below
API_PORT=3001
WEB_URL=http://localhost:5173                     # where the browser reaches the web app: the API redirects here after sign-in, allows it in CORS and links to it in emails
                                                  # Docker Compose (Path 2 of GETTING_STARTED.md): http://localhost
VITE_API_URL=http://localhost:3001                # where the browser reaches the API (build-time for the web image)
VITE_APP_HOST=localhost                           # host used in link previews (build-time for the web image)

# Auth and sessions
SESSION_SECRET=dev-secret-change-me-in-production-must-be-at-least-32-characters   # SECRET — `openssl rand -hex 32`; the dev value is refused when NODE_ENV=production
CREATOR_GITHUB_ID=                                # your GitHub numeric id (https://api.github.com/users/<you>); empty means nobody can sign up
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=                             # SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Sensei (LLM)
LLM_ADAPTER_FORMAT=mock                           # mock | anthropic | openai. `mock` returns canned verdicts that look real: use a real endpoint for anything but a first look
LLM_BASE_URL=https://api.anthropic.com            # a proxy works too, see docs/ops/shellm.md; a trailing /v1 is fine
LLM_MODEL=claude-sonnet-4-6                       # a provider model id. Through SheLLM use `claude` (the CLI's own default) or `claude-sonnet`
LLM_API_KEY=                                      # SECRET — required unless LLM_ADAPTER_FORMAT=mock
LLM_STREAM=true                                   # true = token by token over WebSocket
FF_COURSE_NUDGE_ENABLED=false                     # "Ask the sensei" nudges in scrolls (one LLM call each)
FF_LLM_PREP_STREAMING_ENABLED=false               # stream the kata-prep body over SSE; off uses the 2 s polling path

# Code execution (Piston sandbox)
FF_CODE_EXECUTION_ENABLED=false                   # false returns mocked results; true runs code in Piston (the compose file's Piston cannot, see GETTING_STARTED.md)
PISTON_URL=http://piston:2000                     # dev container: as is. Kamal: set it in the GitHub Environment (docs/ops/deploy.md)
PISTON_MAX_CONCURRENT=3
PISTON_RUN_TIMEOUT=8000                           # ms; Piston also caps run_timeout server-side (the Kamal config sets 8000)
PISTON_COMPILE_TIMEOUT=30000                      # ms; Rust needs the headroom

# Email (Resend)
# Used for access requests, invitations and daily reminders. Set both values or
# neither: the API refuses to start with a key and no sender, and sends nothing
# without a key. Access requests are delivered to the sender address.
RESEND_API_KEY=                                   # SECRET — resend.com/api-keys
RESEND_FROM_EMAIL=                                # a verified Resend sender you own, e.g. dojo <noreply@your-domain>

# Cron
CRON_SECRET=                                      # SECRET — bearer for POST /cron/* (reminders, cleanup-errors, piston-smoke). The scheduled Action that called them is disabled (docs/ops/observability.md); call them from your own scheduler if you want them

# Playground (public anonymous code execution), off by default
# Do NOT turn it on for a public instance until Turnstile and the limits below
# are in place. See docs/specs/027-sprint-022-playground.md §4.
FF_PLAYGROUND_CONSOLE_ENABLED=false               # master gate for POST /playground/run
PLAYGROUND_RATE_LIMIT_ANON_PER_MIN=10             # anonymous, per IP and per session
PLAYGROUND_RATE_LIMIT_ANON_PER_DAY=100
PLAYGROUND_RATE_LIMIT_AUTHED_PER_MIN=60           # signed in, per user
PLAYGROUND_RATE_LIMIT_AUTHED_PER_DAY=1000
PLAYGROUND_DAILY_QUOTA_GLOBAL=5000                # ceiling across everyone, resets at UTC midnight

FF_PLAYGROUND_ASK_SENSEI_ENABLED=false            # signed-in Q&A on the playground (one LLM call each)
PLAYGROUND_ASK_SENSEI_DAILY_QUOTA=30              # asks per user per day; 429 with {used, limit} on overflow

# Turnstile (Cloudflare), the playground bot gate
# Empty values make the middleware a no-op. Set all three on a public instance:
# cloudflare.com → Turnstile → Add site. The site key is public, the secret never leaves the API.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                             # SECRET
VITE_TURNSTILE_SITE_KEY=                          # same value as TURNSTILE_SITE_KEY (web build)

# Sentry (optional)
# Empty DSNs run on console + Postgres only. The Sentry sink is skipped when the
# environment is `development` or `test`, even with a DSN set, so a production
# .env copied to a laptop does not report dev errors. Set the environment to
# `staging` or `production` to enable it.
SENTRY_DSN=                                       # SECRET — API project
SENTRY_ENVIRONMENT=                               # empty → NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=0                       # 0..1; keep 0 until you opt into tracing
SENTRY_RELEASE=                                   # the deploy sets it to the git SHA
VITE_SENTRY_DSN=                                  # SECRET — web project
VITE_SENTRY_ENVIRONMENT=                          # empty → Vite mode
VITE_SENTRY_RELEASE=                              # match SENTRY_RELEASE

# Web build only: source map upload. All three are needed together; if one is missing the upload is skipped.
SENTRY_AUTH_TOKEN=                                # SECRET — org token with org:ci scope
SENTRY_ORG=                                       # your Sentry org slug
SENTRY_PROJECT=dojo-web

# Metrics (Prometheus), optional
# Opt-in: off mounts nothing. METRICS_ENABLED is the gate; the token alone enables nothing.
# Enabled in production without a token, /metrics returns 404 rather than serve data openly.
METRICS_ENABLED=false
METRICS_TOKEN=                                    # SECRET — `openssl rand -hex 32`; scrape with Authorization: Bearer
