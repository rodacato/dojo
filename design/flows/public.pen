                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Dojo is open source under the MIT License. The source code is available on GitHub. The kata content and sensei prompts are part of the codebase — they are not secret.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "yvUlG",
                          "name": "Body",
                          "fill": "$color-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "You can read, fork, and run your own instance, kata catalog included. The license asks only that its copyright notice travels with the code.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
