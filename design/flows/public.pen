          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "UctW6",
          "name": "Heading 1. PURPOSE",
          "fill": "$color-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "1. PURPOSE",
          "lineHeight": 1.5,
          "fontFamily": "$font-mono",
          "fontSize": 11,
          "fontWeight": "normal",
          "letterSpacing": 0.55
        },
        {
          "type": "text",
          "id": "yJvP2",
          "name": "Body 1. PURPOSE",
          "fill": "$color-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Tell a visitor what to do when they arrive: sign in with GitHub, or ask for an invitation. The landing guides; it does not sell the project (that is the GitHub Pages site).",
          "lineHeight": 1.5,
          "fontFamily": "$font-mono",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "gxg57",
          "name": "Heading 2. ENTRY POINTS",
          "fill": "$color-secondary",
          "textGrowth": "fixed-width",
