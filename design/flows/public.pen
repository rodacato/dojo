                  "children": [
                    {
                      "id": "hUu8b",
                      "type": "ref",
                      "ref": "q9jOs",
                      "name": "Body",
                      "content": "The sensei is not a chatbot. It's a structured evaluation system with a persona, a rubric, and a tight feedback loop. The prompt template is in the repo — not hidden, not proprietary.",
                      "width": "fill_container"
                    },
                    {
                      "id": "JejYe",
                      "type": "ref",
                      "ref": "q9jOs",
                      "name": "Body",
                      "content": "Every kata carries an owner_role (who the sensei pretends to be) and an owner_context (what they know). The verdict is one of three values. There is no score.",
                      "width": "fill_container"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "K04T1a",
                  "name": "Example",
                  "width": "fill_container",
                  "stroke": "$color-border",
                  "strokeWidth": {
                    "top": 1,
                    "bottom": 1
