            16
          ],
          "children": [
            {
              "type": "frame",
              "id": "Mtodb",
              "name": "Body column",
              "width": "fill_container",
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "JjU7G",
                  "name": "Section §01",
                  "width": "fill_container",
                  "stroke": "$color-border",
                  "strokeWidth": {
                    "top": 1
                  },
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    24,
                    0,
                    32,
                    0
                  ],
                  "children": [
                    {
                      "id": "Z8C71",
                      "type": "ref",
                      "ref": "GA0AX",
                      "name": "Eyebrow",
                      "content": "§01",
                      "width": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "uDKy8",
                      "name": "H2",
                      "fill": "$color-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What dojo is",
                      "lineHeight": 1.2,
                      "fontFamily": "$font-sans",
                      "fontSize": 22,
                      "fontWeight": "700",
                      "letterSpacing": -0.5
                    },
                    {
                      "id": "hcZWi",
                      "type": "ref",
                      "ref": "yZyh1",
                      "name": "Body",
                      "content": "Dojo is a daily practice tool for software engineers. It assigns you a timed kata, evaluates your response with an AI sensei, and gives you a verdict.",
                      "width": "fill_container"
                    },
                    {
                      "id": "lx4vN",
                      "type": "ref",
                      "ref": "yZyh1",
                      "name": "Body",
                      "content": "Dojo is open-source software that anyone can run. This instance is run by its operator, not by the dojo project, and these terms describe how it works. Access is by invitation: the operator issues the invitation links.",
                      "width": "fill_container"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "f9rHBi",
                  "name": "Section §02",
                  "width": "fill_container",
                  "stroke": "$color-border",
                  "strokeWidth": {
                    "top": 1
                  },
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    24,
                    0,
                    32,
                    0
                  ],
                  "children": [
                    {
                      "id": "FuDC2",
                      "type": "ref",
                      "ref": "GA0AX",
                      "name": "Eyebrow",
                      "content": "§02",
                      "width": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "yUQlX",
                      "name": "H2",
                      "fill": "$color-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What you agree to",
                      "lineHeight": 1.2,
                      "fontFamily": "$font-sans",
                      "fontSize": 22,
                      "fontWeight": "700",
                      "letterSpacing": -0.5
                    },
                    {
                      "id": "T6HvKQ",
                      "type": "ref",
                      "ref": "yZyh1",
                      "name": "Body",
                      "content": "By using dojo, you agree to:",
                      "width": "fill_container"
                    },
                    {
                      "id": "EDnzt",
                      "type": "ref",
                      "ref": "yZyh1",
                      "name": "Body",
                      "content": "· Use a real GitHub account that represents you.\n· Complete kata honestly — the practice only works if it's real.\n· Not abuse the API, attempt to extract evaluation logic, or interfere with other practitioners' sessions.\n· Accept that the sensei's evaluation is generated by an LLM and may occasionally be imperfect.",
                      "width": "fill_container"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "BD2c0",
                  "name": "Section §03",
                  "width": "fill_container",
                  "stroke": "$color-border",
                  "strokeWidth": {
                    "top": 1
                  },
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    24,
                    0,
                    32,
                    0
                  ],
                  "children": [
