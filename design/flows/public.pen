                  "children": [
                    {
                      "id": "D71Ju",
                      "type": "ref",
                      "ref": "GA0AX",
                      "name": "Eyebrow",
                      "content": "SENSEI_SYSTEM_PROMPT.JSON",
                      "width": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "s87aOd",
                      "name": "JSON",
                      "fill": "$color-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "{\n  \"owner_role\": \"Senior DBA — PostgreSQL, 12 yrs\",\n  \"rubric\": [\n    \"process over correctness\",\n    \"identify what the developer demonstrated\",\n    \"identify what they missed or assumed\"\n  ],\n  \"feedback_loops\": \"max 2 follow-ups\",\n  \"verdict\": \"PASSED | PASSED_WITH_NOTES | NEEDS_WORK\"\n}",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
