                    },
                    {
                      "type": "text",
                      "id": "e5KuiO",
                      "name": "Title",
                      "fill": "$color-primary",
                      "content": "Dojo is self-hosted open source",
                      "fontFamily": "$font-sans",
                      "fontSize": 18,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "tnlfH",
                      "name": "Description",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "There is no hosted service. You run an instance for yourself, your friends or your team, and whoever runs it owns its invitations, its data and its LLM bill. This release makes that path real: a fresh install now loads the katas, there is an operator runbook for upgrades, backups and secrets, the security page describes what the code does, and mail never goes out from an address the operator does not own.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
