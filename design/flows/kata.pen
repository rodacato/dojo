                    {
                      "type": "text",
                      "id": "bYMEY",
                      "name": "P",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your product analytics dashboard endpoint is getting slow. It aggregates 90 days of event data for the current user and is now taking 3–8 seconds for active users. You have been asked to fix it.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "CBEu0",
                      "name": "P",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Three engineers on the team each proposed a solution in Slack:",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fIEA6",
                      "name": "P",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Engineer A: \"Add a Redis cache. Cache the result for 5 minutes. Problem solved.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Re51B",
                      "name": "P",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Engineer B: \"The query is the problem. Let's add a materialized view and refresh it hourly.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "JKicC",
                      "name": "P",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· Engineer C: \"This is a read-heavy, user-specific endpoint. Move it behind a CDN with a short TTL and user-scoped cache keys.\"",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "w6Orgn",
                      "name": "P",
                      "fill": "$color-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your tech lead is asking you to decide. Which approach do you recommend, and why? What would make you change your recommendation?",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
