          "type": "text",
          "id": "XUBhh",
          "name": "Body 5. COPY SOURCE",
          "fill": "$color-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "pages/DashboardPage.tsx, components/dashboard/*, components/onboarding/OnboardingOverlay.tsx, layout/*. Sample data: date, counts, kata titles (titles reused from the landing terminal demo).",
